# MANDATE — Environment Variables
# Copy to .env and fill with real values. NEVER commit .env.

# ArmorIQ API Key (required for governed mode)
# Get from: https://platform.armoriq.ai/dashboard/api-keys
ARMORIQ_API_KEY=ak_test_your_key_here

# Groq API Key (for LLM-powered agent reasoning)
# Get from: https://console.groq.com
GROQ_API_KEY=gsk_your_key_here

# Optional: GitHub Token (only if using remote repos)
# GITHUB_TOKEN=ghp_your_token_here
